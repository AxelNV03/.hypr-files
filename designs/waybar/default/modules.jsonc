{
    // =======================================================================
    // WORKSPACE Y SEPARADORES
    // =======================================================================
    "hyprland/workspaces#kanji": {
        "disable-scroll": true,
        "show-special": false,
        "all-outputs": true,
        "on-click": "activate",
        "sort-by": "number",
        "format": "{icon}",
        "persistent-workspaces": { "*": 5 },
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
        }
    },

    "custom/separator#line": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "custom/separator#dot-line": {
        "format": "",
        "interval": "once",
        "tooltip": false
    },
    // =======================================================================
    // MODULOS IZQUIERDA
    // =======================================================================
    "clock": {
        "interval": 1,
        // "format": "󰃭 {:L%A %H:%M}",
        "format": " {:L%H:%M:%S, %B %d}",
        "format-alt": " {:L%H:%M,  %A %d %B %Y }",
        "tooltip-format": "{calendar}",
        "locale": "es_MX.UTF-8",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "days":     "<b>{}</b>",
                "weeks":    "<b>W{}</b>",
                "weekdays": "<b>{}</b>",
                "today":    "<b><u>{}</u></b>"
            }
        }
    },

    "cpu": {
        "interval": 1,
        "format": "󰍛 {usage}%",
        "min-length": 5,
        "format-alt": "󰻠 {avg_frequency}GHz",
        "on-click-right": "kitty --class waybar-monitor -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "󰾆 {used:0.1f}G",
        "format-alt": "󰍛 {percentage}%",
        "tooltip": true,
        "tooltip-format": "Memoria: {used:0.1f}GB de {total:0.1f}GB usados\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
        "on-click-right": "kitty --class waybar-monitor -e btop"
    },

    "temperature": {
        "interval": 10,
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "Temperatura del Procesador: {temperatureC}°C",
        "on-click-right": "kitty --class waybar-monitor -e watch sensors"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip-format": "SSD Sistema (/): {used} de {total}",
        "on-click-right": "kitty --class waybar-monitor -e ncdu /"
    },
    // =======================================================================
    // MODULOS CENTRO
    // =======================================================================
    "custom/lock": {
        "format": "󰌾",
        "tooltip": true,
        "tooltip-format": "bloquear pantalla",
        "on-click": "hyprlock"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "menú de apagado",
        "on-click": "wlogout -b 4",
        "on-click-right": "hyprctl dispatch exit 2>/dev/null || pkill Hyprland"
    },
    // =======================================================================
    // MODULOS DERECHA
    // =======================================================================
    "battery": {
        "full-at": 100,
        "design-capacity": false,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 100%",
        "format-alt": "󱊤 {time}",
        "format-time": "{H}h {M}min",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "Restante: {timeTo}\nConsumo: {power}W"
    },

    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "US",
        "format-es": "LAT",
        "on-click": "hyprctl switchxkblayout all next",
        "tooltip": true,
        "tooltip-format": "Layout: {} | Click para cambiar"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-muted": "󰝟 MUTED",
        "format-source": " {volume}%",
        "format-source-muted": " MUTED",
        "format-icons": ["", "", ""],
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pwvucontrol",
        "tooltip-format": "Salida: {desc} | Vol: {volume}%"
    },

    "backlight": {
        "interval": 2,
        "align": 0,
        "rotate": 0,
        "format": "{icon} {percent}%",
        "format-icons": ["󰃜", "󰃛", "󰃚"],
        "scroll-step": 5,
        "tooltip": true,
        "tooltip-format": "Brillo de pantalla: {percent}%"
    },

    "custom/swaync": {
        "tooltip": true,
        "tooltip-format": "Click: Notificaciones | Click derecho: No molestar",
        "format": "{} {icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 DISCONNECTED",
        "format-alt": "󰛴 {bandwidthUpBytes} 󰛶 {bandwidthDownBytes}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "Señal: {signalStrength}% | IP: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Interfaz: {ifname} | IP: {ipaddr}",
        "on-click-right": "kitty --class waybar-monitor -e nmtui"
    }
}